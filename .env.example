# Copy to .env and adjust. Every setting can also be set as an environment variable.

FARMULATOR_ENVIRONMENT=development

# The API connects as the app role. Row-level security applies to it, so one
# farm can never read another farm's rows. Never point this at a superuser or
# at the table owner: both bypass row-level security.
FARMULATOR_DATABASE_URL=postgresql+asyncpg://farmulator_app:farmulator_app@localhost:5432/farmulator

# Migrations run as the owner role, which owns the tables.
FARMULATOR_MIGRATION_DATABASE_URL=postgresql+asyncpg://farmulator_owner:farmulator_owner@localhost:5432/farmulator

# The role the migrations grant table access to.
FARMULATOR_APP_DB_ROLE=farmulator_app

# Development sign-in: requests identify their farm business with an
# X-Tenant-ID header. Refused in production. Real phone sign-in comes next.
FARMULATOR_DEV_AUTH_ENABLED=true
